{
  "name": "@reububble/web-test",
  "version": "0.1.0",
  "license": "MIT",
  "publish": {
    "include": ["*.ts", "src/**/*.ts", "README.md", "LICENSE", "deno.jsonc"]
  },
  "fmt": { "lineWidth": 160 },
  "imports": {
    "web-test/browser.ts": "./browser.ts",
    "web-test/pipeline.ts": "./pipeline.ts",
    "web-test/": "./src/",
    "tests/": "./tests/",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "puppeteer": "npm:puppeteer@^24.0.0"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  },
  "tasks": {
    "test": "deno test -A --parallel tests/",
    "docs:check": "deno run --allow-read --allow-run scripts/check_docs.ts",
    "publish:check": "deno publish --dry-run",
    "publish:release": "deno publish"
  },
  "exports": {
    "./script": "./script.ts",
    "./runtime": "./runtime.ts",
    "./browser": "./browser.ts",
    "./pipeline": "./pipeline.ts",
    ".": "./mod.ts"
  }
}
