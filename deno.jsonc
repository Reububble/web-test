{
  "name": "@local/web-test",
  "version": "0.1.0",
  "fmt": { "lineWidth": 160 },
  "imports": { "web/": "./src/", "tests/": "./tests/", "@std/assert": "jsr:@std/assert@^1.0.19", "puppeteer": "npm:puppeteer@^24.0.0" },
  "compilerOptions": { "lib": ["dom", "dom.iterable", "esnext", "deno.ns"] },
  "tasks": { "test": "deno test -A --parallel tests/" },
  "exports": { "./runtime": "./runtime.ts", "./browser": "./browser.ts", "./pipeline": "./pipeline.ts", ".": "./mod.ts" }
}
